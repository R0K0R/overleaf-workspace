(ert-deftest ows-test-compile-latexmk-shows-pdf ()
  (skip-unless (executable-find "latexmk"))
  (ows-test--with-open (conn mirror '("machine t.example port 8020 login me@x.org password good") log)
    (let ((m (ows-test--seed-mirror "T" "Doc")) (TeX-output-dir "build"))
      (overleaf-open-project "T" "Doc")
      (ows-test--wait (lambda () (emacs-collab-layout-project m)))
      (with-current-buffer (window-buffer (emacs-collab-layout-window 'editor))
        (let ((proc (overleaf-workspace-compile)))
          (ows-test--wait (lambda () (not (process-live-p proc))) 90)))
      (let ((pdf (expand-file-name "build/main.pdf" m)))
        (should (file-exists-p pdf))
        (ows-test--wait (lambda () (equal (buffer-file-name
                                           (window-buffer (emacs-collab-layout-window 'pdf)))
                                          (file-truename pdf))))))))

