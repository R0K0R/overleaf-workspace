;;; overleaf-workspace-test.el --- Tests  -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'overleaf-workspace)

(defvar TeX-output-dir)

(defconst ows-test--here (file-name-directory (or load-file-name buffer-file-name)))
(defconst ows-test--ec (expand-file-name "~/git_shit/emacs-collab.el/"))

(defun ows-test--tmp ()
  (make-temp-file (expand-file-name "ows-" (or (getenv "EMACS_COLLAB_TEST_TMPDIR")
                                               temporary-file-directory))
                  t))

(defun ows-test--wait (pred &optional timeout)
  (let ((deadline (+ (float-time) (or timeout 15))) r)
    (while (and (not (setq r (funcall pred))) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (or r (ert-fail (list "timeout waiting for" pred)))))

(defmacro ows-test--with-auth (lines &rest body)
  "Run BODY with `auth-sources' a temp authinfo holding LINES."
  (declare (indent 1))
  `(let* ((dir (ows-test--tmp))
          (file (expand-file-name "authinfo" dir))
          (auth-sources (list file))
          (auth-source-cache-expiry nil)
          (auth-source-save-behavior t))
     (auth-source-forget-all-cached)
     (with-temp-file file (insert (mapconcat #'identity ,lines "\n") "\n"))
     (set-file-modes file #o600)
     (unwind-protect (progn ,@body)
       (auth-source-forget-all-cached)
       (delete-directory dir t))))

;;; Pure

(ert-deftest ows-test-parse-project ()
  (let ((id "0123456789abcdef01234567"))
    (should (equal (overleaf-workspace-parse-project id) (list :id id)))
    (should (equal (overleaf-workspace-parse-project
                    (format "https://x.example:10000/project/%s?foo=1" id))
                   (list :id id)))
    (should (equal (overleaf-workspace-parse-project "  My Thesis ") '(:name "My Thesis")))
    (should-error (overleaf-workspace-parse-project " ") :type 'user-error)))

