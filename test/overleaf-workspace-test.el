(ert-deftest ows-test-main-file ()
  (let* ((dir (file-name-as-directory (ows-test--tmp)))
         (conn (emacs-collab--make-conn)))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "a.tex" dir) (insert "% \\documentclass{x}\n\\input{b}\n"))
          (with-temp-file (expand-file-name "b.tex" dir) (insert "\\documentclass{article}\n"))
          (with-temp-file (expand-file-name "c.tex" dir) (insert "text\n"))
          (setf (emacs-collab-conn-root conn) dir
                (emacs-collab-conn-project conn)
                `((main . "c.tex") (files . ["a.tex" "b.tex" "c.tex"])))
          ;; Bridge's main has no \documentclass; the first one that has wins
          ;; (commented-out a.tex does not count).
          (should (equal (overleaf-workspace-main-file conn) (expand-file-name "b.tex" dir)))
          (setf (emacs-collab-conn-project conn) `((main . "b.tex") (files . ["a.tex" "b.tex"])))
          (should (equal (overleaf-workspace-main-file conn) (expand-file-name "b.tex" dir)))
          (setf (emacs-collab-conn-project conn) `((main . "c.tex") (files . ["c.tex"])))
          (should (equal (overleaf-workspace-main-file conn) (expand-file-name "c.tex" dir))))
      (delete-directory dir t))))

;;; auth-source

(ert-deftest ows-test-credentials-password-found ()
  (ows-test--with-auth '("machine yulee.example port 10000 login me@x.org password s3cret")
    (let ((c (overleaf-workspace-credentials
              '(:name "A" :url "https://yulee.example:10000" :auth password))))
      (should (equal (alist-get 'method c) "password"))
      (should (equal (alist-get 'email c) "me@x.org"))
      (should (equal (alist-get 'password c) "s3cret")))
    ;; An explicit :user picks the matching entry.
    (let ((c (overleaf-workspace-credentials
              '(:name "A" :url "https://yulee.example:10000" :auth password :user "me@x.org"))))
      (should (equal (alist-get 'password c) "s3cret")))))

(ert-deftest ows-test-credentials-cookie-found ()
  (ows-test--with-auth '("machine www.overleaf.com login cookie password s%3Aabc.def")
    (let ((c (overleaf-workspace-credentials
              '(:name "O" :url "https://www.overleaf.com" :auth cookie :cookie-name "overleaf_session2"))))
      (should (equal (alist-get 'method c) "cookie"))
      (should (equal (alist-get 'cookie_name c) "overleaf_session2"))
      (should (equal (alist-get 'cookie c) "s%3Aabc.def")))))

(ert-deftest ows-test-credentials-missing-prompts-and-saves ()
  (ows-test--with-auth '("machine other.example login x password y")
    (let ((server '(:name "A" :url "http://yulee.example:8020" :auth password))
          (prompts 0))
      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) (cl-incf prompts) "me@x.org"))
                ((symbol-function 'read-passwd) (lambda (&rest _) (cl-incf prompts) "pw1"))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
        (let ((c (overleaf-workspace-credentials server)))
          (should (equal (alist-get 'password c) "pw1"))
          (should (= prompts 2))))
      ;; Saved: found without prompting now.
      (auth-source-forget-all-cached)
      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) (ert-fail "prompted")))
                ((symbol-function 'read-passwd) (lambda (&rest _) (ert-fail "prompted"))))
        (let ((c (overleaf-workspace-credentials server)))
          (should (equal (alist-get 'email c) "me@x.org"))
          (should (equal (alist-get 'password c) "pw1")))))))

(ert-deftest ows-test-credentials-cookie-missing-prompts-and-saves ()
  (ows-test--with-auth '("machine other.example login x password y")
    (let ((server '(:name "O" :url "https://www.overleaf.com" :auth cookie)))
      (cl-letf (((symbol-function 'read-passwd) (lambda (&rest _) "s%3Acook"))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
        (should (equal (alist-get 'cookie (overleaf-workspace-credentials server)) "s%3Acook"))
        (should (equal (alist-get 'cookie_name (overleaf-workspace-credentials server))
                       "overleaf_session2")))
      (auth-source-forget-all-cached)
      (cl-letf (((symbol-function 'read-passwd) (lambda (&rest _) (ert-fail "prompted"))))
        (should (equal (alist-get 'cookie (overleaf-workspace-credentials server)) "s%3Acook"))))))

;;; With a bridge that wants credentials (loopback behind test/authbridge.py)

(defmacro ows-test--with-open (spec &rest body)
  "SPEC: (CONN MIRROR AUTH-LINES LOG [SECRET]).  Open a project through the shim."
  (declare (indent 1))
  `(let* ((base (ows-test--tmp))
          (overleaf-workspace-mirror-directory (expand-file-name "mirror/" base))
          (overleaf-workspace--sessions nil)
          (emacs-collab--connections nil)
          (emacs-collab-need-auth-function nil)
          (emacs-collab-layout-state-file (expand-file-name "layout.eld" base))
          (emacs-collab-layout--sizes nil) (emacs-collab-layout--sizes-loaded nil)
          (emacs-collab-layout--projects nil) (emacs-collab-layout-register-lsp nil)
          (overleaf-workspace-project-history nil)
          (,(nth 3 spec) (expand-file-name "log" base))
          (process-environment
           (append (list (concat "EMACS_COLLAB_DIR=" ows-test--ec)
                         (concat "AUTHBRIDGE_SECRET=" ,(or (nth 4 spec) "good"))
                         (concat "AUTHBRIDGE_LOG=" ,(nth 3 spec)))
                   process-environment))
          (overleaf-workspace-bridge-command
           (list "python3" (expand-file-name "authbridge.py" ows-test--here)))
          (overleaf-workspace-servers
           '((:name "T" :url "http://t.example:8020" :auth password)
             (:name "C" :url "https://c.example" :auth cookie)))
          (unrelated (generate-new-buffer "*unrelated*")))
     (ows-test--with-auth ,(nth 2 spec)
       (unwind-protect
           (save-window-excursion ,@body)
         (ignore-errors (when overleaf-workspace--sessions (overleaf-quit)))
         (dolist (b (buffer-list))
           (when-let* ((f (buffer-file-name b)))
             (when (string-prefix-p base (file-truename f))
               (with-current-buffer b (set-buffer-modified-p nil)) (kill-buffer b))))
         (kill-buffer unrelated)
         (delete-directory base t)))))

(defun ows-test--seed-mirror (server-slug project-slug)
  "Create the mirror dir content the loopback bridge will serve."
  (let ((d (expand-file-name (concat server-slug "/" project-slug "/") overleaf-workspace-mirror-directory)))
    (make-directory d t)
    (with-temp-file (expand-file-name "main.tex" d)
      (insert "\\documentclass{article}\n\\begin{document}\nhello\n\\end{document}\n"))
    (with-temp-file (expand-file-name "refs.bib" d) (insert "@misc{a}\n"))
    d))

(ert-deftest ows-test-open-layout-quit ()
  (ows-test--with-open (conn mirror '("machine t.example port 8020 login me@x.org password good") log)
    (let* ((id "0123456789abcdef01234567")
           (m (ows-test--seed-mirror "T" id))
           (conn (overleaf-open-project "T" (format "http://t.example/project/%s" id))))
      (ows-test--wait (lambda () (emacs-collab-layout-project m)))
      (let ((p (emacs-collab-layout-project m)))
        (should (eq (emacs-collab-layout-project-conn p) conn))
        (should (emacs-collab-layout-window 'editor))
        (should (emacs-collab-layout-window 'terminal))
        (should (emacs-collab-layout-window 'pdf))
        (should (equal (buffer-file-name (window-buffer (emacs-collab-layout-window 'editor)))
                       (expand-file-name "main.tex" (file-truename m)))))
      (let ((ebuf (window-buffer (emacs-collab-layout-window 'editor))))
        (ows-test--wait (lambda () (with-current-buffer ebuf
                                     (and emacs-collab-mode (emacs-collab-doc-synced (emacs-collab--doc))))))
        (with-current-buffer ebuf
          (should overleaf-workspace-mode)
          (should (eq (key-binding (kbd "M-t q")) #'overleaf-quit))
          (overleaf-workspace-status)
          (overleaf-workspace-resync)
          (ows-test--wait (lambda () (emacs-collab-doc-synced (emacs-collab--doc))))))
      ;; The bridge saw the id, the mirror dir and the credentials; the log has no secret.
      (let ((entry (json-parse-string (car (split-string (with-temp-buffer
                                                         (insert-file-contents log) (buffer-string))
                                                       "\n" t))
                                      :object-type 'alist)))
        (should (equal (alist-get 'project_id (alist-get 'params entry)) id))
        (should (equal (alist-get 'email entry) "me@x.org"))
        (should (equal (alist-get 'method entry) "password")))
      (overleaf-quit)
      (should-not overleaf-workspace--sessions)
      (should-not emacs-collab--connections)
      (should-not (emacs-collab-layout-project m))
      (should (buffer-live-p unrelated))
      (should (= 1 (length (window-list nil 'no-minibuf))))
      (should-not (eq emacs-collab-need-auth-function #'overleaf-workspace--need-auth)))))

(ert-deftest ows-test-need-auth-asks-again ()
  (ows-test--with-open (conn mirror '("machine t.example port 8020 login me@x.org password WRONG") log)
    (let* ((m (ows-test--seed-mirror "T" "Thesis"))
           (asked nil))
      (cl-letf (((symbol-function 'read-passwd) (lambda (&rest _) (push t asked) "good"))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
        (overleaf-open-project "T" "Thesis")
        (ows-test--wait (lambda () (emacs-collab-layout-project m))))
      (should (= (length asked) 1))
      (let ((lines (split-string (with-temp-buffer (insert-file-contents log) (buffer-string)) "\n" t)))
        (should (= (length lines) 2))
        (should (equal (alist-get 'project_name
                                  (alist-get 'params (json-parse-string (car lines) :object-type 'alist)))
                       "Thesis")))
      (overleaf-quit))))

(ert-deftest ows-test-need-auth-gives-up ()
  (ows-test--with-open (conn mirror '("machine t.example port 8020 login me@x.org password WRONG") log)
    (let ((m (ows-test--seed-mirror "T" "Thesis")) (n 0))
      (cl-letf (((symbol-function 'read-passwd) (lambda (&rest _) (cl-incf n) "still-wrong"))
                ((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
        (overleaf-open-project "T" "Thesis")
        (ows-test--wait (lambda () (>= n (1- overleaf-workspace-max-auth-attempts))))
        (accept-process-output nil 0.5))
      (should-not (emacs-collab-layout-project m))
      (should (<= n overleaf-workspace-max-auth-attempts))
      ;; No layout came up: quit still tidies the session.
      (overleaf-quit)
      (should-not overleaf-workspace--sessions)
      (should-not emacs-collab--connections))))

(ert-deftest ows-test-cookie-server ()
