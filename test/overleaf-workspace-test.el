    (let ((m (ows-test--seed-mirror "C" "Proj")))
      (overleaf-open-project "C" "Proj")
      (ows-test--wait (lambda () (emacs-collab-layout-project m)))
      (let ((entry (json-parse-string (car (split-string (with-temp-buffer
                                                         (insert-file-contents log) (buffer-string))
                                                       "\n" t))
                                      :object-type 'alist)))
        (should (equal (alist-get 'method entry) "cookie"))
        (should (equal (alist-get 'cookie_name entry) "overleaf_session2")))
